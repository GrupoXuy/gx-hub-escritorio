# Banco de dados PostgreSQL (Neon, Supabase, Render, Railway etc.)
# Cole o "Direct connection string" (Neon) ou "Session pooler" aqui.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Senha inicial do administrador. Usada APENAS para criar o usuário
# "Henrique Senna" num banco novo, ou para recuperar uma conta sem senha.
# Nunca sobrescreve uma senha já definida — trocá-la pela interface persiste.
# Em produção configure como secret na Vercel, NUNCA neste arquivo.
GX_ADMIN_INITIAL_PASSWORD=

# Credenciais dos scripts de verificação (scripts/verify-*.mjs) e dos testes
# Playwright (tests/). Não são usadas pelo app em runtime.
GX_TEST_EMAIL=
GX_TEST_PASSWORD=

# Alvo dos testes. Padrão: http://127.0.0.1:3000
GX_TEST_BASE_URL=

# Desliga a ferramenta de calibração das mobílias (/calibrar). Por padrão ela
# está ligada — inclusive em produção — porque o preview do sandbox é efêmero.
# A página não acessa o banco, mas defina "0" para escondê-la.
GX_CALIBRATOR=

# Opcional — servidor TURN para chamadas em redes corporativas restritivas
# Obtenha um serviço gratuito em: https://global.stunproject.org/turn/ ou Twilio
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
